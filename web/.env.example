# In Vercel deployments, SOILVISION_BACKEND_URL is automatically injected via
# the internal `ml_backend` service binding declared in the root `vercel.json`.
# Set it manually only when running Next.js and FastAPI separately during local dev.
SOILVISION_BACKEND_URL=http://127.0.0.1:8000

# Optional shared secret sent as X-API-Key from Next.js API routes to FastAPI
SOILVISION_BACKEND_API_KEY=
